<%- include('./head') %><%- include('./nav') %><section class="admin-panel form-panel"><div class="panel-heading"><div><p class="admin-kicker">PUBLIC UPDATE</p><h2><%= editing ? 'Edit announcement' : 'Add announcement' %></h2></div><a class="admin-link" href="/admin/announcements">← Back</a></div><% if (formError) { %><div class="notice notice-error"><%= formError %></div><% } %><form class="admin-form" action="<%= editing ? '/admin/announcements/edit/' + announcement._id : '/admin/announcements/create' %>" method="post" enctype="multipart/form-data"><div class="form-grid"><label class="span-2">Title<input name="title" required maxlength="160" value="<%= announcement.title || '' %>"></label><label>Type<select name="type"><% ['announcement','deal','project-launch'].forEach(function(type) { %><option value="<%= type %>" <%= announcement.type === type ? 'selected' : '' %>><%= type %></option><% }); %></select></label><label>Date<input type="date" name="startDate" required value="<%= announcement.startDate ? new Date(announcement.startDate).toISOString().slice(0,10) : '' %>"></label><label class="span-2">Description<textarea name="description" required maxlength="3000" rows="7"><%= announcement.description || '' %></textarea></label><label>Image<input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif"></label><label>Or Image URL<input type="url" name="imageUrl" placeholder="https://"></label><label class="span-2">URL Slug<input name="slug" maxlength="160" value="<%= announcement.slug || '' %>"></label></div><% if (editing && announcement.image) { %><div class="existing-main"><img src="<%= announcement.image %>" alt=""><span>Current image</span></div><% } %><div class="form-switches"><label><input type="checkbox" name="featured" <%= announcement.featured ? 'checked' : '' %>> Feature on homepage</label><label><input type="checkbox" name="active" <%= announcement.active ? 'checked' : '' %>> Publish publicly</label></div><div class="form-actions"><button class="admin-button"><%= editing ? 'Save Changes' : 'Create announcement' %> <span>→</span></button><a class="admin-cancel" href="/admin/announcements">Cancel</a></div></form></section><%- include('./foot') %>
