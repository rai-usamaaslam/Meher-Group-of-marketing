<%- include('./head') %><%- include('./nav') %><section class="admin-panel form-panel"><div class="panel-heading"><div><p class="admin-kicker">PUBLIC UPDATE</p><h2><%= editing ? 'Edit announcement' : 'Add announcement' %></h2></div><a class="admin-link" href="/admin/announcements">← Back</a></div><% if (formError) { %><div class="notice notice-error"><%= formError %></div><% } %><form class="admin-form" action="<%= editing ? '/admin/announcements/edit/' + announcement._id : '/admin/announcements/create' %>" method="post"><div class="form-grid"><label class="span-2">Title<input name="title" required maxlength="160" value="<%= announcement.title || '' %>"></label><label>Date<input type="date" name="startDate" required value="<%= announcement.startDate ? new Date(announcement.startDate).toISOString().slice(0,10) : '' %>"></label><label>Image URL<input type="url" name="imageUrl" required placeholder="https://" value="<%= announcement.image || '' %>"></label><label class="span-2">Description<textarea name="description" required maxlength="3000" rows="7"><%= announcement.description || '' %></textarea></label></div><div class="form-actions"><button class="admin-button"><%= editing ? 'Save Changes' : 'Create announcement' %> <span>→</span></button><a class="admin-cancel" href="/admin/announcements">Cancel</a></div></form></section><%- include('./foot') %>
