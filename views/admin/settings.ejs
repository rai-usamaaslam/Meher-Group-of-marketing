<%- include('./head') %><%- include('./nav') %><section class="admin-panel form-panel"><div class="panel-heading"><div><p class="admin-kicker">ACCOUNT SECURITY</p><h2>Account settings</h2></div></div><form class="admin-form settings-form" action="/admin/settings/username" method="post"><h3>Username and email</h3><div class="form-grid"><label>Name<input name="name" required value="<%= user.name %>"></label><label>Email<input type="email" name="email" required value="<%= user.email %>"></label></div><div class="form-actions"><button class="admin-button">Save account details</button></div></form><form class="admin-form settings-form" action="/admin/settings/password" method="post"><h3>Change password</h3><div class="form-grid"><label>Current password<input type="password" name="currentPassword" required autocomplete="current-password"></label><label>New password<input type="password" name="password" required minlength="8" autocomplete="new-password"></label><label class="span-2">Confirm new password<input type="password" name="confirmation" required minlength="8" autocomplete="new-password"></label></div><div class="form-actions"><button class="admin-button">Change password</button></div></form></section><%- include('./foot') %>
