<%- include('./head') %><%- include('./nav') %>
<section class="admin-panel"><div class="panel-heading"><div><p class="admin-kicker">PUBLIC UPDATES</p><h2>Manage announcements</h2></div><a class="admin-button" href="/admin/announcements/create">Add announcement <span>+</span></a></div>
<% if (announcements.length) { %><div class="table-wrap"><table class="admin-table"><thead><tr><th>Image</th><th>Title</th><th>Date</th><th>Actions</th></tr></thead><tbody><% announcements.forEach(function(item) { %><tr><td><% if (item.image) { %><img class="table-image" src="<%= item.image %>" alt=""><% } else { %><span class="image-placeholder">—</span><% } %></td><td><strong><%= item.title %></strong></td><td><%= new Date(item.startDate).toLocaleDateString() %></td><td><div class="table-actions"><a href="/announcements/<%= item.slug %>" target="_blank" rel="noopener">View</a><a href="/admin/announcements/edit/<%= item._id %>">Edit</a><form action="/admin/announcements/delete/<%= item._id %>" method="post" data-confirm="Delete this announcement permanently?"><button>Delete</button></form></div></td></tr><% }); %></tbody></table></div><% } else { %><div class="empty-state"><h3>No announcements yet</h3><p>Share company and project updates with visitors.</p></div><% } %></section><%- include('./foot') %>
