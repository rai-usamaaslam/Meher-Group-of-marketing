<%- include('./head') %><%- include('./nav') %>
<section class="admin-panel">
  <div class="panel-heading">
    <div><p class="admin-kicker">CLIENT FEEDBACK</p><h2>Manage testimonials</h2></div>
    <a class="admin-button" href="/admin/testimonials/create">Add testimonial <span>+</span></a>
  </div>
  <% if (testimonials.length) { %>
  <div class="table-wrap"><table class="admin-table">
    <thead><tr><th>Profile</th><th>Name</th><th>Message</th><th>Date</th><th>Visibility</th><th>Actions</th></tr></thead>
    <tbody><% testimonials.forEach(function(item) { %><tr>
      <td><% if (item.image) { %><img class="table-image" src="<%= item.image %>" alt=""><% } else { %><span class="image-placeholder">—</span><% } %></td>
      <td><strong><%= item.name %></strong></td>
      <td><%= item.message.length > 120 ? item.message.slice(0, 120) + '…' : item.message %></td>
      <td><%= new Date(item.date).toLocaleDateString() %></td>
      <td><form action="/admin/testimonials/toggle/<%= item._id %>" method="post"><button class="visibility <%= item.isActive ? 'is-active' : '' %>" type="submit"><%= item.isActive ? 'Published' : 'Draft' %></button></form></td>
      <td><div class="table-actions"><a href="/admin/testimonials/edit/<%= item._id %>">Edit</a><form action="/admin/testimonials/delete/<%= item._id %>" method="post" data-confirm="Delete this testimonial permanently?"><button type="submit">Delete</button></form></div></td>
    </tr><% }); %></tbody>
  </table></div>
  <% } else { %>
  <div class="empty-state"><h3>No testimonials yet</h3><p>Add a client testimonial to feature it on the homepage.</p><a class="admin-button" href="/admin/testimonials/create">Add testimonial <span>+</span></a></div>
  <% } %>
</section>
<%- include('./foot') %>
