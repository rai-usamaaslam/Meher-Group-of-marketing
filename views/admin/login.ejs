<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#17324D"><title><%= title %></title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/admin.css"></head><body class="login-body"><main class="login-card"><a class="login-brand" href="/"><strong>MGM</strong><span>Meher Group of Marketing</span></a><p class="admin-kicker">SECURE ADMIN AREA</p><h1><%= setup ? 'Set up your administrator account' : 'Welcome back' %></h1><p><%= setup ? 'Create the first administrator account to begin managing MGM listings and inquiries.' : 'Sign in to manage MGM projects and contact inquiries.' %></p><% if (error) { %><div class="notice notice-error"><%= error %></div><% } %><form class="login-form" action="<%= setup ? '/admin/setup' : '/admin/login' %>" method="post"><% if (setup) { %><label>Your name<input name="name" autocomplete="name" required minlength="2"></label><% } %><label>Email<input name="email" type="email" autocomplete="email" required></label><label>Password<input name="password" type="password" autocomplete="<%= setup ? 'new-password' : 'current-password' %>" required minlength="8"></label><button class="admin-button" type="submit"><%= setup ? 'Create administrator' : 'Sign in' %> <span>→</span></button></form><a class="back-site" href="/">← Back to MGM website</a></main></body></html>
