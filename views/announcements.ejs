<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="icon" href="/images/favicon.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/approachable.css"><script src="/js/main.js" defer></script></head><body><%- include('./partials/navbar') %><main><section class="about-hero section-pad"><p class="eyebrow"><span></span> MGM UPDATES</p><h1>Latest <em>announcements.</em></h1><p>Company news, project updates, and timely opportunities from MGM.</p></section><section class="announcement-preview section-pad"><% if (announcements.length) { %><div class="announcement-grid"><% announcements.forEach(function(item) { %><article class="announcement-card"><% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.title %>"><% } %><p class="eyebrow"><span></span> <%= new Date(item.startDate).toLocaleDateString() %></p><h2><%= item.title %></h2><p><%= item.description %></p></article><% }); %></div><% } else { %><div class="project-empty is-static"><p>There are no announcements to share right now. Please check back soon.</p></div><% } %></section></main><%- include('./partials/footer') %></body></html>
