<% if (typeof announcements !== 'undefined' && announcements.length) { %><section class="announcement-preview section-pad"><div class="project-heading"><div><p class="eyebrow"><span></span> MGM UPDATES</p><h2>Latest <em>Announcements</em></h2></div><p>News and updates from Meher Group of Marketing.</p></div><div class="announcement-grid"><% announcements.forEach(function(item) { %><article class="announcement-card"><% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><p class="eyebrow"><span></span> <%= new Date(item.startDate).toLocaleDateString() %></p><h3><%= item.title %></h3><p><%= item.description %></p></article><% }); %></div><a class="text-link" href="/announcements">See all announcements <span>↗</span></a></section><% } %>
