<% if (testimonials && testimonials.length) { %><section class="home-testimonials section-pad"><div class="home-section-heading"><div><p class="eyebrow"><span></span> WHAT CLIENTS SAY</p><h2>It’s better <em>together.</em></h2></div><div class="slider-controls"><button type="button" data-scroll-carousel="testimonials-carousel" data-scroll-direction="previous" aria-label="Previous testimonials">←</button><button type="button" data-scroll-carousel="testimonials-carousel" data-scroll-direction="next" aria-label="Next testimonials">→</button></div></div><div class="testimonial-carousel" id="testimonials-carousel"><% testimonials.forEach(function(item) { %><article class="testimonial-card"><% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>"><% } %><blockquote><p>“<%= item.message %>”</p><footer><strong><%= item.name %></strong><span><%= new Date(item.date).toLocaleDateString() %></span></footer></blockquote></article><% }); %></div></section><% } %>
