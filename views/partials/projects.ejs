<section class="home-projects section-pad" id="projects"><div class="home-section-heading"><div><p class="eyebrow"><span></span> PROPERTY AND DEVELOPMENT</p><h2>Explore Our <em>Projects</em></h2></div><div class="slider-controls"><button type="button" data-scroll-carousel="projects-carousel" data-scroll-direction="previous" aria-label="Previous projects">←</button><button type="button" data-scroll-carousel="projects-carousel" data-scroll-direction="next" aria-label="Next projects">→</button></div></div><% if (projects.length) { %><div class="home-card-carousel" id="projects-carousel"><% projects.forEach(function(project) { %><article class="home-project-card"><a class="home-project-image" href="/projects/<%= project.slug %>"><img src="<%= project.featuredImage || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=82' %>" alt="<%= project.title %>" loading="lazy" width="760" height="560"></a><div class="home-project-copy"><p class="eyebrow"><span></span> <%= categoryLabels[project.category] || project.category %></p><h3><%= project.title %></h3><% if (project.location) { %><p class="home-project-location"><%= project.location %></p><% } %><% if (project.propertyType || project.price) { %><p class="home-project-meta"><%= [project.propertyType, project.price].filter(Boolean).join(' · ') %></p><% } %><a class="text-link" href="/projects/<%= project.slug %>">View details <span>↗</span></a></div></article><% }); %></div><% } else { %><p class="home-empty">Projects will appear here as they are published.</p><% } %><a class="home-all-projects" href="/projects">View all projects <span>↗</span></a></section>
