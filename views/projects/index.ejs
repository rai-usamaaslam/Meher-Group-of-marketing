<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#17324D"><meta name="description" content="Explore MGM's ongoing projects, completed projects, properties for sale, and properties for rent."><title><%= title %></title><link rel="icon" href="/images/favicon.svg" type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/approachable.css"><link rel="stylesheet" href="/css/projects-page.css"><script src="/js/main.js" defer></script>  <link rel="stylesheet" href="/css/typography.css">
</head><body><%- include('../partials/navbar') %><main><section class="about-hero section-pad"><p class="eyebrow"><span></span> MGM PROPERTIES</p><h1>Explore our <em>projects.</em></h1><p>Browse current developments, completed projects, and available properties in one place.</p></section><% const sections = [{ key: 'ongoing', title: 'Ongoing Projects', description: 'Developments currently moving forward.' }, { key: 'completed', title: 'Completed Projects', description: 'Projects delivered with care and attention.' }, { key: 'sale', title: 'Properties for Sale', description: 'Available properties and investment opportunities.' }, { key: 'rental', anchor: 'rent', title: 'Properties for Rent', description: 'Rental options currently available.' }]; %><% sections.forEach(function(section) { const projects = projectGroups[section.key]; %><section class="projects-page-section section-pad" id="<%= section.anchor || section.key %>"><div class="projects-page-heading"><div><p class="eyebrow"><span></span> MGM PROPERTIES</p><h2><%= section.title %></h2></div><p><%= section.description %></p></div><% if (projects.length) { %><div class="projects-page-grid"><% projects.forEach(function(project) { %><article class="projects-page-card"><a class="projects-page-image" href="/projects/<%= project.slug %>" aria-label="View <%= project.title %>"><img src="<%= project.featuredImage || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=82' %>" alt="<%= project.title %>" loading="lazy" width="760" height="560"><% if (project.isFeatured) { %><span>Featured</span><% } %></a><div class="projects-page-copy"><h3><%= project.title %></h3><% if (project.location) { %><p class="projects-page-location"><%= project.location %></p><% } %><% if (project.status) { %><p class="projects-page-status"><%= project.status %></p><% } %><% if (project.propertyType) { %><p class="projects-page-meta"><%= project.propertyType %></p><% } %><% if (project.price || project.priceLabel) { %><p class="projects-page-price"><%= [project.priceLabel, project.price].filter(Boolean).join(' ') %></p><% } %><% if (project.shortDescription) { %><p class="projects-page-description"><%= project.shortDescription %></p><% } %><a class="text-link" href="/projects/<%= project.slug %>">View details <span>↗</span></a></div></article><% }); %></div><% } else { %><p class="projects-page-empty">No <%= section.title.toLowerCase() %> are available right now.</p><% } %></section><% }); %></main><%- include('../partials/footer') %></body></html>
