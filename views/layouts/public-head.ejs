<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#17324D">
  <meta name="robots" content="index,follow">
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (typeof siteUrl !== 'undefined' && siteUrl) { %><link rel="canonical" href="<%= siteUrl %><%= page === 'home' ? '/' : (typeof currentPath !== 'undefined' ? currentPath : (typeof req !== 'undefined' && req.originalUrl ? req.originalUrl : '')) %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <% if (typeof siteUrl !== 'undefined' && siteUrl) { %><meta property="og:url" content="<%= siteUrl %><%= currentPath || '/' %>"><% } %>
  <meta property="og:site_name" content="Meher Group of Marketing and Construction">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
  <% if (page === 'home') { %>
  <meta property="og:image" content="<%= siteUrl %>/images/hero-img.jpg">
  <meta name="twitter:image" content="<%= siteUrl %>/images/hero-img.jpg">
  <% } %>
  <title><%= title %></title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <% (cssSections || []).forEach(function(section) { %><link rel="stylesheet" href="/section-assets/<%= section %>/<%= section %>.css"><% }); %>
  <% (jsSections || []).forEach(function(section) { %><script src="/section-assets/<%= section %>/<%= section %>.js" defer></script><% }); %>
  <% if (page === 'home') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["RealEstateAgent", "Organization"],
    "name": "Meher Group of Marketing and Construction",
    "alternateName": "MGM",
    "url": "<%= siteUrl %>",
    "description": "Islamabad-based real estate, property marketing, property development, and construction company.",
    "telephone": "+923194449191",
    "email": "mahirgroupofmarketing@gmail.com",
    "areaServed": { "@type": "City", "name": "Islamabad, Pakistan" },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "G-08 Prime Arcade, Near Tableghi Markaz, Zamar Valley",
      "addressLocality": "Islamabad",
      "addressCountry": "PK"
    }
  }
  </script>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"WebSite","name":"Meher Group of Marketing and Construction","alternateName":"MGM","url":"<%= siteUrl %>"}
  </script>
  <% } %>
</head>
