<main class="announcement-detail section-pad">
  <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href="/announcements">Announcements</a><span aria-hidden="true">/</span><span aria-current="page"><%= announcement.title %></span></nav>
  <a class="announcement-back" href="/announcements">← All Announcements</a>
  <article>
    <% if (announcement.image) { %><img class="announcement-detail-image" src="<%= announcement.image %>" alt="<%= announcement.title %>" width="1800" height="1013"><% } %>
    <div class="announcement-detail-copy">
      <p class="announcement-date"><time datetime="<%= new Date(announcement.startDate).toISOString() %>"><%= new Date(announcement.startDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></time></p>
      <h1><%= announcement.title %></h1>
      <div class="announcement-detail-body"><%= announcement.description %></div>
      <a class="announcement-back" href="/announcements">← Back to Announcements</a>
    </div>
  </article>
</main>
