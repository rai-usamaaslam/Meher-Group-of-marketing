<main class="announcements-page">
  <header class="announcements-page-heading section-pad">
    <p class="eyebrow"><span></span> MGM UPDATES</p>
    <h1>Latest Announcements</h1>
    <p>Company news, project updates, and opportunities from Meher Group of Marketing.</p>
  </header>
  <section class="announcements-page-list section-pad" aria-label="All published announcements">
    <% if (announcements.length) { %>
    <div class="announcement-grid">
      <% announcements.forEach(function(item) { %>
      <article class="announcement-card">
        <a class="announcement-card-image" href="/announcements/<%= item.slug %>" aria-label="Read <%= item.title %>">
          <img src="<%= item.image || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80' %>" alt="<%= item.title %>" loading="lazy">
        </a>
        <div class="announcement-card-copy">
          <p class="announcement-date"><time datetime="<%= new Date(item.startDate).toISOString() %>"><%= new Date(item.startDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></time></p>
          <h2><a href="/announcements/<%= item.slug %>"><%= item.title %></a></h2>
          <p class="announcement-excerpt"><%= item.description.length > 180 ? item.description.slice(0, 180).trim() + '…' : item.description %></p>
          <a class="announcement-read-more" href="/announcements/<%= item.slug %>">Read More <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <% }); %>
    </div>
    <% } else { %>
    <p class="announcement-empty">There are no announcements to share right now. Please check back soon.</p>
    <% } %>
  </section>
</main>
