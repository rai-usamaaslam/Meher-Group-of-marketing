<section class="latest-news-section" aria-labelledby="latest-news-heading">
  <div class="latest-news-container">
    <div class="latest-news-header">
      <div class="latest-news-title">
        <span class="latest-news-label">INSIGHTS &amp; UPDATES</span>
        <h2 id="latest-news-heading">Latest News</h2>
        <div class="latest-news-line" aria-hidden="true"></div>
      </div>

      <a href="/announcements" class="latest-news-view-all">
        All News
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <% if (announcements && announcements.length) { %>
    <div class="latest-news-slider-wrapper">
      <button class="latest-news-arrow latest-news-prev" type="button" aria-label="Previous news">
        <span aria-hidden="true">←</span>
      </button>

      <div class="latest-news-slider" role="region" aria-label="Latest news" tabindex="0">
        <div class="latest-news-track">
          <% announcements.forEach(function(item) { %>
          <article class="latest-news-card">
            <div class="latest-news-image">
              <img
                src="<%= item.image || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80' %>"
                alt="<%= item.title %>"
                loading="lazy"
                width="760"
                height="520"
              >

              <div class="latest-news-category">
                <%= ({ deal: 'Property offer', announcement: 'Announcement', 'project-launch': 'Project launch' })[item.type] || 'MGM news' %>
              </div>

              <div class="latest-news-overlay" aria-hidden="true"></div>
            </div>

            <div class="latest-news-content">
              <time class="latest-news-date" datetime="<%= new Date(item.startDate).toISOString() %>"><%= new Date(item.startDate).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) %></time>

              <h3>
                <a href="/announcements/<%= item.slug %>"><%= item.title %></a>
              </h3>

              <p>
                <%= item.description.length > 140 ? item.description.slice(0, 140).trim() + '…' : item.description %>
              </p>

              <a href="/announcements/<%= item.slug %>" class="latest-news-read">
                Read More <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
          <% }); %>
        </div>
      </div>

      <button class="latest-news-arrow latest-news-next" type="button" aria-label="Next news">
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="latest-news-pagination" aria-label="Latest news pages"></div>
    <% } else { %>
    <p class="announcement-empty">There are no announcements to share right now. Please check back soon.</p>
    <% } %>
  </div>
</section>
