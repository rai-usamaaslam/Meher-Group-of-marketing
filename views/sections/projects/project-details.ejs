<main class="project-detail">
  <nav class="detail-breadcrumb section-pad" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page"><%= project.title %></span></nav>
  <section class="project-detail-hero">
    <% if (project.featuredImage) { %><img src="<%= project.featuredImage %>" alt="<%= project.title %>" width="1800" height="1000"><% } %>
    <div></div>
    <div class="project-detail-hero-copy section-pad">
      <p class="eyebrow"><span></span> <%= categoryLabels[project.category] || project.category %></p>
      <h1><%= project.title %></h1>
      <p><%= project.location %></p>
    </div>
  </section>
  <section class="project-detail-content section-pad">
    <div class="project-detail-main">
      <p class="eyebrow"><span></span> PROPERTY OVERVIEW</p>
      <h2><%= project.shortDescription %></h2>
      <p class="project-long-description"><%= project.description %></p>
      <% if (project.features && project.features.length) { %>
      <section class="project-features">
        <h3>Features</h3>
        <ul><% project.features.forEach(function(feature) { %><li><span>✓</span><%= feature %></li><% }); %></ul>
      </section>
      <% } %>
    </div>
    <aside class="project-facts">
      <% if (project.status) { %><div><span>Status</span><strong><%= project.status %></strong></div><% } %>
      <% if (project.propertyType) { %><div><span>Property type</span><strong><%= project.propertyType %></strong></div><% } %>
      <% if (project.area) { %><div><span>Area</span><strong><%= project.area %> <%= project.areaUnit || '' %></strong></div><% } %>
      <% if (project.bedrooms !== undefined && project.bedrooms !== null) { %><div><span>Bedrooms</span><strong><%= project.bedrooms %></strong></div><% } %>
      <% if (project.bathrooms !== undefined && project.bathrooms !== null) { %><div><span>Bathrooms</span><strong><%= project.bathrooms %></strong></div><% } %>
    </aside>
  </section>
  <% if (project.gallery && project.gallery.length) { %>
  <section class="project-gallery section-pad">
    <p class="eyebrow"><span></span> GALLERY</p>
    <div><% project.gallery.forEach(function(image) { %><img src="<%= image %>" alt="<%= project.title %> gallery image" loading="lazy" width="900" height="620"><% }); %></div>
  </section>
  <% } %>
  <section class="property-contact section-pad">
    <div><p class="eyebrow"><span></span> LET’S TALK</p><h2>Interested in this property?</h2><p>Ask about this listing and we’ll help you with the next step.</p></div>
    <div class="hero-actions">
      <a class="button button-primary" href="/contact">Contact Us <span>↗</span></a>
      <a class="button button-secondary" href="https://wa.me/923200098162" rel="noopener noreferrer">WhatsApp <span>↗</span></a>
      <a class="button button-secondary" href="tel:03194449191">Call <span>↗</span></a>
    </div>
  </section>
</main>
