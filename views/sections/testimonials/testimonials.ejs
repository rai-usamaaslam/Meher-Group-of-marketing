<section class="home-testimonials section-pad" id="testimonials"><div class="home-section-heading"><div><p class="eyebrow"><span></span> WHAT CLIENTS SAY</p><h2>It’s better <em>together.</em></h2></div><% if (testimonials.length > 1) { %><div class="slider-controls"><button type="button" data-scroll-carousel="testimonials-carousel" data-scroll-direction="previous" aria-label="Previous testimonials">←</button><button type="button" data-scroll-carousel="testimonials-carousel" data-scroll-direction="next" aria-label="Next testimonials">→</button></div><% } %></div><% if (testimonials.length) { %><div class="testimonial-carousel" id="testimonials-carousel" role="region" aria-label="Client testimonials" tabindex="0"><% testimonials.forEach(function(item) { %><article class="testimonial-card"><% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy"><% } else { %><span class="testimonial-avatar" aria-hidden="true"><%= item.name.charAt(0).toUpperCase() %></span><% } %><blockquote><p>“<%= item.message %>”</p><footer><strong><%= item.name %></strong><span><%= new Date(item.date).toLocaleDateString() %></span></footer></blockquote></article><% }); %></div><% } else { %><p class="home-empty">Client testimonials will appear here as they are published.</p><% } %></section>
