<article class="property-card <%= cardVariant ? cardVariant + '-card' : '' %>" data-project-category="<%= project.category %>">
  <div class="property-card-image <%= cardVariant ? cardVariant + '-image' : '' %>">
    <a class="property-card-image-link" href="/projects/<%= project.slug %>" aria-label="View <%= project.title %>">
      <img src="<%= project.featuredImage || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=82' %>" alt="<%= project.title %>" loading="lazy" width="760" height="570">
    </a>
    <span class="property-card-badge"><%= project.isFeatured ? 'Featured' : (project.status || 'Available') %></span>
    <div class="property-card-actions">
      <button class="property-card-action" type="button" data-project-favorite data-project-title="<%= project.title %>" aria-pressed="false" aria-label="Save <%= project.title %> to favorites">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.7c0 5.4-8.8 10.3-8.8 10.3S3.2 14.1 3.2 8.7a4.7 4.7 0 0 1 8.8-2.3 4.7 4.7 0 0 1 8.8 2.3Z"/></svg>
      </button>
      <button class="property-card-action" type="button" data-project-share data-project-title="<%= project.title %>" data-share-url="/projects/<%= project.slug %>" aria-label="Share <%= project.title %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.7 10.6 6.6-4.2m-6.6 7 6.6 4.2"/></svg>
      </button>
    </div>
    <a class="property-card-overlay-link" href="/projects/<%= project.slug %>"><span>View Property <span aria-hidden="true">↗</span></span></a>
  </div>

  <div class="property-card-copy <%= cardVariant ? cardVariant + '-copy' : '' %>">
    <p class="property-card-category"><span></span><%= (categoryLabels && categoryLabels[project.category]) || project.propertyType || 'Property' %></p>
    <h3><a href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
    <% if (project.location) { %>
    <p class="property-card-location">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <%= project.location %>
    </p>
    <% } %>
    <% if (project.shortDescription) { %><p class="property-card-description"><%= project.shortDescription %></p><% } %>

    <% if (project.propertyType || project.bedrooms !== undefined && project.bedrooms !== null || project.bathrooms !== undefined && project.bathrooms !== null || project.area) { %>
    <dl class="property-card-facts" aria-label="Property details">
      <% if (project.propertyType) { %><div><dt>Type</dt><dd><%= project.propertyType %></dd></div><% } %>
      <% if (project.bedrooms !== undefined && project.bedrooms !== null) { %><div><dt>Bedrooms</dt><dd><%= project.bedrooms %></dd></div><% } %>
      <% if (project.bathrooms !== undefined && project.bathrooms !== null) { %><div><dt>Bathrooms</dt><dd><%= project.bathrooms %></dd></div><% } %>
      <% if (project.area) { %><div><dt>Area</dt><dd><%= project.area %> <small><%= project.areaUnit || 'sq ft' %></small></dd></div><% } %>
    </dl>
    <% } %>

    <div class="property-card-footer">
      <p class="property-card-price">
        <span><%= project.category === 'rental' ? 'For Rent' : (project.status || 'Available') %></span>
        <% if (project.price || project.priceLabel) { %><strong><%= [project.priceLabel, project.price].filter(Boolean).join(' ') %></strong><% } else { %><strong>Contact for price</strong><% } %>
      </p>
      <a class="property-card-details" href="/projects/<%= project.slug %>">View Details <span aria-hidden="true">↗</span></a>
    </div>
    <span class="property-card-status" data-property-card-status aria-live="polite"></span>
  </div>
</article>
