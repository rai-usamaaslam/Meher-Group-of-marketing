<% if (typeof renderProjectCard !== 'undefined' && renderProjectCard) { %>
<% var projectImage = project.featuredImage || (project.gallery && project.gallery.length ? project.gallery[0] : ''); %>
<article class="project-card<%= typeof cardVariant !== 'undefined' && cardVariant ? ' ' + cardVariant + '-card' : '' %>" data-project-category="<%= project.category %>">
  <div class="project-image">
    <% if (projectImage) { %>
    <img src="<%= projectImage %>" alt="<%= project.title %>" loading="lazy" width="760" height="480">
    <% } else { %>
    <div class="project-image-placeholder" role="img" aria-label="Image unavailable for <%= project.title %>">MGM</div>
    <% } %>
    <div class="project-overlay" aria-hidden="true"></div>
    <span class="project-status"><%= project.status || 'New' %></span>
    <button class="project-favorite" type="button" data-project-favorite data-project-title="<%= project.title %>" aria-pressed="false" aria-label="Add <%= project.title %> to favorites">♡</button>
    <button class="project-share" type="button" data-project-share data-project-title="<%= project.title %>" data-share-url="/projects/<%= project.slug %>" aria-label="Share <%= project.title %>">↗</button>
  </div>

  <div class="project-content">
    <div class="project-top">
      <span class="project-category"><%= (categoryLabels && categoryLabels[project.category]) || project.propertyType || 'Property' %></span>
      <span class="project-status-text"><%= project.status || 'Available' %></span>
    </div>
    <h3 class="project-title"><a href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
    <% if (project.location) { %>
    <p class="project-location"><span aria-hidden="true">⌖</span><span><%= project.location %></span></p>
    <% } %>
    <p class="project-description"><%= project.shortDescription || project.description || '' %></p>

    <div class="project-details" aria-label="Project details">
      <% if (project.propertyType) { %><span class="project-detail"><span class="project-detail-icon" aria-hidden="true">⌂</span><span><%= project.propertyType %></span></span><% } %>
      <% if (project.bedrooms !== undefined && project.bedrooms !== null) { %><span class="project-detail"><span class="project-detail-icon" aria-hidden="true">▣</span><span><%= project.bedrooms %> Beds</span></span><% } %>
      <% if (project.bathrooms !== undefined && project.bathrooms !== null) { %><span class="project-detail"><span class="project-detail-icon" aria-hidden="true">▣</span><span><%= project.bathrooms %> Baths</span></span><% } %>
      <% if (project.area !== undefined && project.area !== null) { %><span class="project-detail"><span class="project-detail-icon" aria-hidden="true">□</span><span><%= project.area %> <%= project.areaUnit || 'sq ft' %></span></span><% } %>
      <% if (!project.propertyType && project.bedrooms == null && project.bathrooms == null && project.area == null) { %><span class="project-detail"><span class="project-detail-icon" aria-hidden="true">⌂</span><span><%= (categoryLabels && categoryLabels[project.category]) || 'Real Estate' %></span></span><% } %>
    </div>

    <div class="project-bottom">
      <a class="project-button" href="/projects/<%= project.slug %>">View Details <span aria-hidden="true">→</span></a>
    </div>
    <span class="project-feedback" data-project-feedback aria-live="polite"></span>
  </div>
</article>
<% } else { %>
<section class="projects-section" id="projects" aria-labelledby="projects-heading">
  <div class="projects-container">
    <div class="projects-header">
      <div class="projects-title">
        <span class="projects-label">Our Portfolio</span>
        <h2 id="projects-heading">Latest Projects</h2>
        <div class="projects-line" aria-hidden="true"></div>
      </div>
      <a href="/projects" class="projects-view-all">View All Projects <span aria-hidden="true">→</span></a>
    </div>
    <% if (projects && projects.length) { %>
    <div class="projects-slider-wrapper">
      <% if (projects.length > 1) { %>
      <button class="projects-arrow projects-prev" type="button" aria-label="Previous project" disabled><span aria-hidden="true">←</span></button>
      <% } %>
      <div class="projects-slider" role="region" aria-label="Latest projects" aria-roledescription="carousel" tabindex="0">
        <div class="projects-track">
          <% projects.forEach(function(project) { %>
          <%- include('./project-card', { project: project, categoryLabels: categoryLabels, renderProjectCard: true }) %>
          <% }); %>
        </div>
      </div>
      <% if (projects.length > 1) { %>
      <button class="projects-arrow projects-next" type="button" aria-label="Next project"><span aria-hidden="true">→</span></button>
      <% } %>
    </div>
    <div class="projects-pagination" aria-label="Project slides"></div>
    <% } else { %>
    <p class="projects-empty">Projects will appear here as they are published.</p>
    <% } %>
  </div>
</section>
<% } %>
