<section class="contact-section section-pad" id="contact" aria-labelledby="contact-title">
  <div class="contact-info">
    <p class="eyebrow"><span></span> START A CONVERSATION</p>
    <h2 id="contact-title">Let’s talk about what you’re <em>looking for.</em></h2>
    <p>Have a question about a property, project, or rental? Get in touch and we’ll help you with the next step.</p>
    <div class="contact-details">
      <div><span>PHONE</span><strong><a href="tel:03194449191">03194449191</a></strong></div>
      <div><span>WHATSAPP</span><strong><a href="https://wa.me/923200098162" rel="noopener noreferrer">03200098162</a></strong></div>
      <div><span>EMAIL</span><strong><a href="mailto:mahirgroupofmarketing@gmail.com">mahirgroupofmarketing@gmail.com</a></strong></div>
      <div><span>OFFICE</span><strong>G-08 Prime Arcade, Near Tableghi Markaz, Zamar Valley, Islamabad</strong></div>
    </div>
  </div>

  <form class="contact-form" id="contact-form" action="/contact" method="post" novalidate>
    <label for="full-name">Full Name</label>
    <input id="full-name" name="name" autocomplete="name" required minlength="2">
    <span class="field-error" data-error="name"></span>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" required>
    <span class="field-error" data-error="email"></span>
    <label for="phone">Phone</label>
    <input id="phone" name="phone" type="tel" autocomplete="tel" required>
    <span class="field-error" data-error="phone"></span>
    <label for="subject">Subject / Inquiry Type</label>
    <select id="subject" name="subject" required>
      <option value="" selected disabled>Choose an option</option>
      <% inquirySubjects.forEach(function(subject) { %><option value="<%= subject %>"><%= subject %></option><% }); %>
    </select>
    <span class="field-error" data-error="subject"></span>
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
    <span class="field-error" data-error="message"></span>
    <button class="button button-dark" type="submit"><span class="submit-label">Send Message</span><span aria-hidden="true">↗</span></button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</section>
