<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= statusCode === 404 ? 'Page Not Found | MGM' : 'Something Went Wrong | MGM' %></title><style>body{display:grid;min-height:100vh;place-items:center;margin:0;padding:24px;background:#FFFFFF;color:#111111;font-family:Arial,sans-serif}.error-card{max-width:580px;padding:44px;border:1px solid rgba(17,17,17,.13);border-radius:12px;background:#FFFFFF;box-shadow:0 14px 35px rgba(17,17,17,.08)}p{color:#666666;line-height:1.7}a{display:inline-block;margin-top:10px;padding:12px 16px;border-radius:6px;background:#111111;color:#FFFFFF;text-decoration:none}</style></head><body><main class="error-card"><p><%= statusCode %></p><h1><%= message || 'Something went wrong.' %></h1><p><%= statusCode === 404 ? 'The page or listing you requested is unavailable.' : 'Please try again shortly or return to the homepage.' %></p><a href="/">Return home</a></main></body></html>
